# Copy this file to `.env` in the same folder and fill in real values.
# .env is loaded automatically at startup (spring-dotenv) and must never be committed.

SERVER_PORT=7000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=careerlabs_lms
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# CORS - comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3040

# Hibernate DDL strategy: validate | update | none (use validate/none in production)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Seeds one login-ready user on startup when the users table is empty.
# Disable in production (APP_SEED_ENABLED=false).
APP_SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@careerlabs.com
SEED_ADMIN_PASSWORD=ChangeMe123!

LOG_LEVEL=INFO
